evolution_lab_js = """(() => {
  'use strict';
  const evolutionData = {
    naturalSelection: {
      ar: { title: 'الانتقاء الطبيعي', description: 'محاكاة تطور لون الفراء في الأرانب عبر الأجيال', instructions: 'اضبط نسبة الافتراس وشاهد كيف يتغير توزيع الألوان', generations: 'الأجيال', population: 'الجماعة', trait: 'الصفة', frequency: 'التكرار', light: 'فاتح', dark: 'داكن', predation: 'ضغط الافتراس', reset: 'إعادة', start: 'بدء المحاكاة', stop: 'إيقاف', explanation: 'الانتقاء الطبيعي يفضل الأفراد المتكيفين مع بيئتهم. في بيئة داكنة، الأرانب ذات الفراء الداكن أقل عرضة للافتراس.' }
    }
  };
  let currentLang = 'ar';
  let simulationRunning = false;
  let simulationInterval = null;

  class EvolutionLab {
    constructor() {
      this.generations = 0;
      this.population = [];
      this.lightFrequency = 0.5;
      this.darkFrequency = 0.5;
      this.predationPressure = 0.3;
      this.init();
    }
    init() { this.renderLab(); this.setupEventListeners(); this.initializePopulation(); }
    renderLab() {
      const container = document.getElementById('evolution-lab');
      if (!container) return;
      const data = evolutionData.naturalSelection[currentLang];
      container.innerHTML = `
        <div class="evo-lab-container">
          <div class="evo-lab-header"><h2>${data.title}</h2><p>${data.description}</p></div>
          <div class="evo-lab-controls">
            <div class="evo-control-group">
              <label>${data.predationPressure}</label>
              <input type="range" id="evo-predation" min="0" max="100" value="30">
              <span id="evo-predation-value">30%</span>
            </div>
            <div class="evo-buttons">
              <button id="evo-start" class="evo-btn-primary">${data.start}</button>
              <button id="evo-reset" class="evo-btn-secondary">${data.reset}</button>
            </div>
          </div>
          <div class="evo-lab-visualization">
            <div class="evo-population-display">
              <div class="evo-generation-counter"><span>${data.generations}:</span><strong id="evo-generation-count">0</strong></div>
              <div id="evo-rabbits-container" class="evo-rabbits-grid"></div>
            </div>
            <div class="evo-frequency-chart">
              <h3>${data.frequency}</h3>
              <div class="evo-chart-bars">
                <div class="evo-bar-group">
                  <div class="evo-bar-label">${data.light}</div>
                  <div class="evo-bar-container"><div id="evo-light-bar" class="evo-bar evo-bar-light" style="width: 50%"></div></div>
                  <div id="evo-light-freq" class="evo-bar-value">50%</div>
                </div>
                <div class="evo-bar-group">
                  <div class="evo-bar-label">${data.dark}</div>
                  <div class="evo-bar-container"><div id="evo-dark-bar" class="evo-bar evo-bar-dark" style="width: 50%"></div></div>
                  <div id="evo-dark-freq" class="evo-bar-value">50%</div>
                </div>
              </div>
            </div>
          </div>
          <div class="evo-lab-explanation"><p>${data.explanation}</p></div>
        </div>
      `;
    }
    initializePopulation() {
      this.population = [];
      for (let i = 0; i < 100; i++) {
        this.population.push({ color: Math.random() < 0.5 ? 'light' : 'dark', fitness: 1 });
      }
      this.updateDisplay();
    }
    setupEventListeners() {
      const predationSlider = document.getElementById('evo-predation');
      const startBtn = document.getElementById('evo-start');
      const resetBtn = document.getElementById('evo-reset');
      if (predationSlider) {
        predationSlider.addEventListener('input', (e) => {
          this.predationPressure = e.target.value / 100;
          document.getElementById('evo-predation-value').textContent = e.target.value + '%';
        });
      }
      if (startBtn) {
        startBtn.addEventListener('click', () => {
          if (simulationRunning) this.stopSimulation();
          else this.startSimulation();
        });
      }
      if (resetBtn) { resetBtn.addEventListener('click', () => this.resetSimulation()); }
    }
    startSimulation() {
      simulationRunning = true;
      const startBtn = document.getElementById('evo-start');
      const data = evolutionData.naturalSelection[currentLang];
      if (startBtn) startBtn.textContent = data.stop;
      simulationInterval = setInterval(() => this.nextGeneration(), 1000);
    }
    stopSimulation() {
      simulationRunning = false;
      clearInterval(simulationInterval);
      const startBtn = document.getElementById('evo-start');
      const data = evolutionData.naturalSelection[currentLang];
      if (startBtn) startBtn.textContent = data.start;
    }
    resetSimulation() {
      this.stopSimulation();
      this.generations = 0;
      this.lightFrequency = 0.5;
      this.darkFrequency = 0.5;
      this.initializePopulation();
    }
    nextGeneration() {
      this.generations++;
      const newPopulation = [];
      this.population.forEach(individual => {
        let survivalChance = 1;
        if (individual.color === 'light') survivalChance = 1 - this.predationPressure;
        else survivalChance = 1 - (this.predationPressure * 0.3);
        if (Math.random() < survivalChance) {
          newPopulation.push({ color: individual.color, fitness: individual.fitness * 1.1 });
          if (newPopulation.length < 100) newPopulation.push({ color: individual.color, fitness: individual.fitness });
        }
      });
      while (newPopulation.length < 100) {
        const parent = this.population[Math.floor(Math.random() * this.population.length)];
        newPopulation.push({ color: parent.color, fitness: parent.fitness });
      }
      this.population = newPopulation.slice(0, 100);
      this.updateFrequencies();
      this.updateDisplay();
    }
    updateFrequencies() {
      const lightCount = this.population.filter(i => i.color === 'light').length;
      const darkCount = this.population.filter(i => i.color === 'dark').length;
      const total = this.population.length;
      this.lightFrequency = lightCount / total;
      this.darkFrequency = darkCount / total;
    }
    updateDisplay() {
      const container = document.getElementById('evo-rabbits-container');
      const generationCount = document.getElementById('evo-generation-count');
      const lightBar = document.getElementById('evo-light-bar');
      const darkBar = document.getElementById('evo-dark-bar');
      const lightFreq = document.getElementById('evo-light-freq');
      const darkFreq = document.getElementById('evo-dark-freq');
      if (container) {
        container.innerHTML = '';
        this.population.forEach((individual, index) => {
          const rabbit = document.createElement('div');
          rabbit.className = `evo-rabbit evo-rabbit-${individual.color}`;
          rabbit.style.animationDelay = `${index * 0.01}s`;
          container.appendChild(rabbit);
        });
      }
      if (generationCount) generationCount.textContent = this.generations;
      if (lightBar) lightBar.style.width = `${this.lightFrequency * 100}%`;
      if (darkBar) darkBar.style.width = `${this.darkFrequency * 100}%`;
      if (lightFreq) lightFreq.textContent = `${Math.round(this.lightFrequency * 100)}%`;
      if (darkFreq) darkFreq.textContent = `${Math.round(this.darkFrequency * 100)}%`;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { window.evolutionLab = new EvolutionLab(); });
  } else { window.evolutionLab = new EvolutionLab(); }
})();
"""

