student_space_js = """(() => {
  'use strict';

  class StudentSpace {
    constructor() {
      this.init();
    }

    init() {
      this.loadUserData();
      this.setupNavigation();
      this.renderAchievements();
    }

    loadUserData() {
      if (!window.GoSVT || !window.GoSVT.auth || !window.GoSVT.auth.isLoggedIn()) {
        this.showGuestMode();
        return;
      }

      const user = window.GoSVT.auth.getCurrentUser();
      const stats = window.GoSVT.tracker.getStats();

      document.getElementById('ss-welcome-name').textContent = `مرحباً ${user.name}! 👋`;
      document.getElementById('ss-welcome-message').textContent = 
        `مستواك: ${user.level} | واصل التعلم لتحقيق أهدافك`;
      
      document.getElementById('ss-stat-labs').textContent = stats.completedLabs;
      document.getElementById('ss-stat-score').textContent = stats.averageScore + '%';
      document.getElementById('ss-stat-streak').textContent = stats.studyStreak;

      document.getElementById('ss-completed-labs').textContent = stats.completedLabs;
      document.getElementById('ss-avg-score').textContent = stats.averageScore + '%';
      document.getElementById('ss-achievements').textContent = stats.achievements;
      document.getElementById('ss-streak').textContent = stats.studyStreak;

      document.getElementById('ss-progress-percent').textContent = stats.completionRate + '%';
      document.getElementById('ss-progress-fill').style.width = stats.completionRate + '%';
      document.getElementById('ss-progress-text').textContent = 
        `أنت في مستوى ${user.level} - أكمل ${stats.completedLabs} من 25 مختبر`;

      // Tags
      const tags = document.getElementById('ss-welcome-tags');
      tags.innerHTML = `
        <span>📊 ${stats.completionRate}% مكتمل</span>
        <span>🎯 ${stats.averageScore}% متوسط</span>
        <span>🔥 ${stats.studyStreak} يوم متتالي</span>
      `;
    }

    showGuestMode() {
      document.getElementById('ss-welcome-name').textContent = 'مرحباً بك في Go SVT! 👋';
      document.getElementById('ss-welcome-message').textContent = 
        'سجل دخولك لتتبع تقدمك وحفظ إنجازاتك';
    }

    setupNavigation() {
      document.querySelectorAll('.main-nav a').forEach(link => {
        link.addEventListener('click', (e) => {
          const href = link.getAttribute('href');
          if (href.startsWith('#')) {
            e.preventDefault();
            const target = document.querySelector(href);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }
        });
      });
    }

    renderAchievements() {
      if (!window.GoSVT || !window.GoSVT.achievements) return;
      
      const achievements = window.GoSVT.achievements.getAllAchievements();
      const grid = document.getElementById('achievements-grid');
      
      if (!grid || achievements.length === 0) return;

      grid.innerHTML = achievements.map(a => `
        <div class="ss-achievement-card ${a.earned ? 'earned' : 'locked'}">
          <div class="ss-achievement-icon">${a.icon}</div>
          <div class="ss-achievement-info">
            <strong>${a.title.ar}</strong>
            <small>${a.description.ar}</small>
          </div>
          ${a.earned ? '<span class="ss-earned-badge">✓</span>' : ''}
        </div>
      `).join('');
    }
  }

  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      window.StudentSpace = new StudentSpace();
    });
  } else {
    window.StudentSpace = new StudentSpace();
  }
})();
"""

create_file('student-space.js', student_space_js)

