student_system_js = """(() => {
  'use strict';

  const Storage = {
    get(key, def = null) {
      try { const d = localStorage.getItem(`gsvt_${key}`); return d ? JSON.parse(d) : def; }
      catch (e) { return def; }
    },
    set(key, val) {
      try { localStorage.setItem(`gsvt_${key}`, JSON.stringify(val)); return true; }
      catch (e) { return false; }
    },
    remove(key) { localStorage.removeItem(`gsvt_${key}`); }
  };

  class StudentAuth {
    constructor() {
      this.currentUser = Storage.get('current_user', null);
      this.students = Storage.get('students', []);
    }
    register(name, email, level, password) {
      if (this.students.find(s => s.email === email)) {
        return { success: false, message: 'البريد مسجل مسبقاً' };
      }
      const student = {
        id: Date.now().toString(36) + Math.random().toString(36).substr(2),
        name: name.trim(), email: email.trim().toLowerCase(), level,
        password: btoa(password),
        createdAt: new Date().toISOString(),
        lastActive: new Date().toISOString(),
        progress: {
          completedLabs: [], quizScores: {}, achievements: [],
          studyStreak: 0, lastStudyDate: null
        }
      };
      this.students.push(student);
      Storage.set('students', this.students);
      this.currentUser = student;
      Storage.set('current_user', student);
      return { success: true, student };
    }
    login(email, password) {
      const student = this.students.find(
        s => s.email === email.toLowerCase() && s.password === btoa(password)
      );
      if (!student) return { success: false, message: 'بيانات غير صحيحة' };
      student.lastActive = new Date().toISOString();
      Storage.set('students', this.students);
      this.currentUser = student;
      Storage.set('current_user', student);
      return { success: true, student };
    }
    logout() { this.currentUser = null; Storage.remove('current_user'); }
    updateProfile(updates) {
      if (!this.currentUser) return false;
      Object.assign(this.currentUser, updates);
      const idx = this.students.findIndex(s => s.id === this.currentUser.id);
      if (idx !== -1) {
        this.students[idx] = this.currentUser;
        Storage.set('students', this.students);
        Storage.set('current_user', this.currentUser);
      }
      return true;
    }
    isLoggedIn() { return this.currentUser !== null; }
    getCurrentUser() { return this.currentUser; }
  }

  class ProgressTracker {
    constructor(auth) { this.auth = auth; }
    saveLabProgress(labId, score, completed = true) {
      if (!this.auth.isLoggedIn()) return false;
      const s = this.auth.getCurrentUser();
      s.progress.quizScores[labId] = {
        labId, score, completed,
        completedAt: new Date().toISOString(),
        attempts: (s.progress.quizScores[labId]?.attempts || 0) + 1
      };
      if (completed && !s.progress.completedLabs.includes(labId)) {
        s.progress.completedLabs.push(labId);
      }
      this.updateStudyStreak(s);
      this.auth.updateProfile({ progress: s.progress });
      return true;
    }
    updateStudyStreak(s) {
      const today = new Date().toDateString();
      const last = s.progress.lastStudyDate ? new Date(s.progress.lastStudyDate).toDateString() : null;
      if (last !== today) {
        const yesterday = new Date(); yesterday.setDate(yesterday.getDate() - 1);
        s.progress.studyStreak = last === yesterday.toDateString() ? s.progress.studyStreak + 1 : 1;
        s.progress.lastStudyDate = new Date().toISOString();
      }
    }
    getStats() {
      if (!this.auth.isLoggedIn()) return null;
      const s = this.auth.getCurrentUser();
      const p = s.progress;
      const scores = Object.values(p.quizScores).filter(x => x.completed).map(x => x.score);
      const avg = scores.length ? Math.round(scores.reduce((a, b) => a + b, 0) / scores.length) : 0;
      return {
        completedLabs: p.completedLabs.length, totalLabs: 25,
        completionRate: Math.round((p.completedLabs.length / 25) * 100),
        averageScore: avg, studyStreak: p.studyStreak,
        achievements: p.achievements.length, level: s.level
      };
    }
  }

  class AchievementSystem {
    constructor(auth, tracker) {
      this.auth = auth; this.tracker = tracker;
      this.achievements = [
        { id: 'first_lab', title: { ar: 'أول خطوة', fr: 'Premier pas' }, description: { ar: 'أكمل أول مختبر', fr: 'Compléter le premier laboratoire' }, icon: '🔬', condition: s => s.completedLabs >= 1 },
        { id: 'five_labs', title: { ar: 'مستكشف', fr: 'Explorateur' }, description: { ar: 'أكمل 5 مختبرات', fr: 'Compléter 5 laboratoires' }, icon: '🧪', condition: s => s.completedLabs >= 5 },
        { id: 'perfect_score', title: { ar: 'علامة كاملة', fr: 'Score parfait' }, description: { ar: 'احصل على 100%', fr: 'Obtenir 100%' }, icon: '🏆', condition: s => s.averageScore === 100 },
        { id: 'streak_7', title: { ar: 'ملتزم', fr: 'Régulier' }, description: { ar: '7 أيام متتالية', fr: '7 jours consécutifs' }, icon: '🔥', condition: s => s.studyStreak >= 7 },
        { id: 'half_way', title: { ar: 'نصف الطريق', fr: 'Mi-chemin' }, description: { ar: 'أكمل نصف المختبرات', fr: 'Compléter la moitié' }, icon: '⭐', condition: s => s.completionRate >= 50 },
        { id: 'master', title: { ar: 'خبير SVT', fr: 'Expert SVT' }, description: { ar: 'أكمل جميع المختبرات', fr: 'Compléter tous les laboratoires' }, icon: '🎓', condition: s => s.completionRate === 100 }
      ];
    }
    checkAchievements() {
      if (!this.auth.isLoggedIn()) return [];
      const s = this.auth.getCurrentUser();
      const stats = this.tracker.getStats();
      const newA = [];
      this.achievements.forEach(a => {
        if (!s.progress.achievements.includes(a.id) && a.condition(stats)) {
          s.progress.achievements.push(a.id);
          newA.push(a);
        }
      });
      if (newA.length > 0) this.auth.updateProfile({ progress: s.progress });
      return newA;
    }
    getAllAchievements() {
      if (!this.auth.isLoggedIn()) return [];
      const s = this.auth.getCurrentUser();
      return this.achievements.map(a => ({ ...a, earned: s.progress.achievements.includes(a.id) }));
    }
  }

  class StudentUI {
    constructor(auth, tracker, achievements) {
      this.auth = auth; this.tracker = tracker; this.achievements = achievements;
    }
    createAuthModal() {
      const modal = document.createElement('div');
      modal.className = 'gsvt-auth-modal';
      modal.innerHTML = `
        <div class="gsvt-auth-container">
          <button class="gsvt-auth-close" aria-label="إغلاق">×</button>
          <div class="gsvt-auth-header"><h2>Go SVT Maroc</h2><p>مختبر علوم الحياة والأرض</p></div>
          <div class="gsvt-auth-tabs">
            <button class="gsvt-auth-tab active" data-tab="login">تسجيل الدخول</button>
            <button class="gsvt-auth-tab" data-tab="register">حساب جديد</button>
          </div>
          <form class="gsvt-auth-form" id="gsvt-login-form">
            <div class="gsvt-form-group"><label>البريد الإلكتروني</label><input type="email" name="email" required placeholder="example@email.com"></div>
            <div class="gsvt-form-group"><label>كلمة المرور</label><input type="password" name="password" required placeholder="••••••••"></div>
            <button type="submit" class="gsvt-btn-primary">دخول</button>
            <div class="gsvt-auth-message"></div>
          </form>
          <form class="gsvt-auth-form hidden" id="gsvt-register-form">
            <div class="gsvt-form-group"><label>الاسم الكامل</label><input type="text" name="name" required placeholder="محمد العلوي"></div>
            <div class="gsvt-form-group"><label>البريد الإلكتروني</label><input type="email" name="email" required placeholder="example@email.com"></div>
            <div class="gsvt-form-group"><label>المستوى</label><select name="level" required><option value="">اختر المستوى</option><option value="TC">جذع مشترك</option><option value="1BAC">أولى باكالوريا</option><option value="2BAC">ثانية باكالوريا</option></select></div>
            <div class="gsvt-form-group"><label>كلمة المرور</label><input type="password" name="password" required placeholder="••••••••" minlength="6"></div>
            <button type="submit" class="gsvt-btn-primary">إنشاء حساب</button>
            <div class="gsvt-auth-message"></div>
          </form>
        </div>`;
      document.body.appendChild(modal);
      this.setupAuthEvents(modal);
      return modal;
    }
    setupAuthEvents(modal) {
      modal.querySelectorAll('.gsvt-auth-tab').forEach(tab => {
        tab.addEventListener('click', () => {
          modal.querySelectorAll('.gsvt-auth-tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          const tabName = tab.dataset.tab;
          modal.querySelectorAll('.gsvt-auth-form').forEach(form => {
            form.classList.toggle('hidden', form.id !== `gsvt-${tabName}-form`);
          });
        });
      });
      modal.querySelector('.gsvt-auth-close').addEventListener('click', () => modal.remove());
      modal.addEventListener('click', e => { if (e.target === modal) modal.remove(); });
      document.getElementById('gsvt-login-form').addEventListener('submit', e => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const result = this.auth.login(fd.get('email'), fd.get('password'));
        const msg = e.target.querySelector('.gsvt-auth-message');
        if (result.success) {
          msg.textContent = 'تم تسجيل الدخول!'; msg.className = 'gsvt-auth-message success';
          setTimeout(() => { modal.remove(); this.updateUI(); window.location.reload(); }, 1000);
        } else { msg.textContent = result.message; msg.className = 'gsvt-auth-message error'; }
      });
      document.getElementById('gsvt-register-form').addEventListener('submit', e => {
        e.preventDefault();
        const fd = new FormData(e.target);
        const result = this.auth.register(fd.get('name'), fd.get('email'), fd.get('level'), fd.get('password'));
        const msg = e.target.querySelector('.gsvt-auth-message');
        if (result.success) {
          msg.textContent = 'تم إنشاء الحساب!'; msg.className = 'gsvt-auth-message success';
          setTimeout(() => { modal.remove(); this.updateUI(); window.location.reload(); }, 1000);
        } else { msg.textContent = result.message; msg.className = 'gsvt-auth-message error'; }
      });
    }
    updateUI() {
      const actions = document.getElementById('header-actions');
      if (!actions) return;
      actions.innerHTML = '';
      if (this.auth.isLoggedIn()) {
        const user = this.auth.getCurrentUser();
        const btn = document.createElement('button');
        btn.className = 'gsvt-user-btn';
        btn.textContent = `👤 ${user.name}`;
        btn.addEventListener('click', () => {
          if (confirm('هل تريد تسجيل الخروج؟')) {
            this.auth.logout();
            this.updateUI();
            window.location.reload();
          }
        });
        actions.appendChild(btn);
      } else {
        const btn = document.createElement('button');
        btn.className = 'gsvt-auth-btn';
        btn.textContent = 'تسجيل الدخول';
        btn.addEventListener('click', () => this.createAuthModal());
        actions.appendChild(btn);
      }
    }
  }

  const auth = new StudentAuth();
  const tracker = new ProgressTracker(auth);
  const achievements = new AchievementSystem(auth, tracker);
  const ui = new StudentUI(auth, tracker, achievements);

  ui.updateUI();
  window.GoSVT = { auth, tracker, achievements, ui };
})();
"""

