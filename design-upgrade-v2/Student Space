      if (prevBtn) { prevBtn.addEventListener('click', () => { if (currentStage > 0) { currentStage--; this.renderLab(); } }); }
      if (nextBtn) { nextBtn.addEventListener('click', () => { const data = physiologyData[currentSystem][currentLang]; if (currentStage < data.stages.length - 1) { currentStage++; this.renderLab(); } }); }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => { window.physiologyLab = new PhysiologyLab(); });
  } else { window.physiologyLab = new PhysiologyLab(); }
})();
