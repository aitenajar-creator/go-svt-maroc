video_system_js = """(() => {
  'use strict';
  class VideoSystem {
    constructor() {
      this.videos = {};
      this.watched = JSON.parse(localStorage.getItem('gsvt_watched') || '[]');
      this.load();
    }
    async load() {
      try {
        const res = await fetch('videos.json');
        this.videos = await res.json();
        this.render();
      } catch (e) { console.error('Video load error:', e); }
    }
    getAll() {
      return Object.values(this.videos).flatMap(l => Object.values(l).flat());
    }
    isWatched(id) { return this.watched.includes(id); }
    markWatched(id) {
      if (!this.watched.includes(id)) {
        this.watched.push(id);
        localStorage.setItem('gsvt_watched', JSON.stringify(this.watched));
      }
    }
    render() {
      const container = document.getElementById('video-library');
      if (!container) return;
      const all = this.getAll();
      container.innerHTML = `
        <div class="vl-header">
          <h2>📹 مكتبة الفيديوهات التعليمية</h2>
          <p>${all.length} فيديو في علوم الحياة والأرض</p>
        </div>
        <div class="vl-filters">
          <select id="vl-level">
            <option value="">جميع المستويات</option>
            <option value="tc">جذع مشترك</option>
            <option value="1bac">أولى باكالوريا</option>
            <option value="2bac">ثانية باكالوريا</option>
          </select>
          <select id="vl-subject">
            <option value="">جميع المواضيع</option>
            <option value="cellule">الخلية</option>
            <option value="genetique">الوراثة</option>
            <option value="photosynthese">التركيب الضوئي</option>
            <option value="immunite">المناعة</option>
          </select>
        </div>
        <div class="vl-grid">${all.map(v => this.card(v)).join('')}</div>
      `;
      document.getElementById('vl-level').addEventListener('change', e => this.filter(e.target.value, document.getElementById('vl-subject').value));
      document.getElementById('vl-subject').addEventListener('change', e => this.filter(document.getElementById('vl-level').value, e.target.value));
      this.bindPlay();
    }
    card(v) {
      const w = this.isWatched(v.id);
      return `
        <div class="vl-card ${w ? 'watched' : ''}" data-id="${v.id}">
          <div class="vl-thumb">
            <img src="${v.thumbnail}" alt="${v.title.ar}" loading="lazy">
            <span class="vl-dur">${v.duration}</span>
            ${w ? '<span class="vl-badge">✓ تمت المشاهدة</span>' : ''}
          </div>
          <div class="vl-info">
            <h3>${v.title.ar}</h3>
            <p>${v.description.ar}</p>
            <button class="vl-play" data-url="${v.url}" data-id="${v.id}">▶ مشاهدة</button>
          </div>
        </div>`;
    }
    filter(level, subject) {
      const grid = document.querySelector('.vl-grid');
      let list = level ? (this.videos[level] || []) : this.getAll();
      list = level ? Object.values(list).flat() : list;
      if (subject) list = list.filter(v => v.id.includes(subject));
      grid.innerHTML = list.map(v => this.card(v)).join('');
      this.bindPlay();
    }
    bindPlay() {
      document.querySelectorAll('.vl-play').forEach(btn => {
        btn.addEventListener('click', () => this.play(btn.dataset.url, btn.dataset.id));
      });
    }
    play(url, id) {
      const m = document.createElement('div');
      m.className = 'vl-modal';
      m.innerHTML = `
        <div class="vl-player">
          <button class="vl-close">×</button>
          <iframe src="${url}?autoplay=1" allowfullscreen allow="autoplay; encrypted-media"></iframe>
        </div>`;
      document.body.appendChild(m);
      const close = () => { m.remove(); this.markWatched(id); this.render(); };
      m.querySelector('.vl-close').addEventListener('click', close);
      m.addEventListener('click', e => { if (e.target === m) close(); });
    }
  }
  window.GoSVTVideos = new VideoSystem();
})();
"""

