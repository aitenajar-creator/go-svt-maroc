review_system_js = """(() => {
  'use strict';
  const reviewData = {
    ar: {
      title: 'آراء الطلاب', subtitle: 'شارك تجربتك مع المختبرات التفاعلية',
      rating: 'التقييم', review: 'المراجعة', submit: 'إرسال',
      helpful: 'مفيد', report: 'إبلاغ', sortBy: 'ترتيب حسب',
      newest: 'الأحدث', highest: 'الأعلى تقييماً', mostHelpful: 'الأكثر فائدة',
      noReviews: 'لا توجد مراجعات بعد. كن أول من يشارك!',
      yourRating: 'تقييمك', yourReview: 'مراجعتك',
      writeReview: 'اكتب مراجعتك هنا...', minChars: '10 أحرف على الأقل',
      success: 'تم إرسال مراجعتك بنجاح!', error: 'حدث خطأ. حاول مرة أخرى.',
      confirmDelete: 'هل أنت متأكد من حذف هذه المراجعة؟', deleted: 'تم حذف المراجعة.',
      reportSubmitted: 'تم إرسال البلاغ. شكراً لمساعدتنا!',
      leaderboard: 'لوحة المتصدرين', topReviewers: 'أفضل المراجعين',
      reviews: 'مراجعة', avgRating: 'متوسط التقييم', totalReviews: 'إجمالي المراجعات',
      helpfulCount: 'مفيد', daysAgo: 'منذ {{days}} يوم', hoursAgo: 'منذ {{hours}} ساعة',
      minutesAgo: 'منذ {{minutes}} دقيقة', justNow: 'الآن'
    }
  };
  let currentLang = 'ar';

  class ReviewSystem {
    constructor() {
      this.reviews = JSON.parse(localStorage.getItem('gsvt_reviews') || '{}');
      this.ratings = JSON.parse(localStorage.getItem('gsvt_ratings') || '{}');
      this.helpful = JSON.parse(localStorage.getItem('gsvt_helpful') || '[]');
      this.currentUser = this.getCurrentUser();
    }
    getCurrentUser() {
      if (window.GoSVT && window.GoSVT.auth && window.GoSVT.auth.isLoggedIn()) {
        return window.GoSVT.auth.getCurrentUser();
      }
      return null;
    }
    getLabReviews(labId) { return this.reviews[labId] || []; }
    getLabRating(labId) {
      const ratings = this.ratings[labId] || [];
      if (ratings.length === 0) return 0;
      const sum = ratings.reduce((acc, r) => acc + r.rating, 0);
      return (sum / ratings.length).toFixed(1);
    }
    getLabRatingCount(labId) { return (this.ratings[labId] || []).length; }
    addReview(labId, rating, text) {
      if (!this.currentUser) return { success: false, message: 'يجب تسجيل الدخول أولاً' };
      if (text.length < 10) return { success: false, message: 'المراجعة قصيرة جداً (10 أحرف على الأقل)' };
      if (rating < 1 || rating > 5) return { success: false, message: 'التقييم يجب أن يكون بين 1 و 5' };
      const review = {
        id: Date.now().toString(36) + Math.random().toString(36).substr(2),
        labId, userId: this.currentUser.id, userName: this.currentUser.name,
        userLevel: this.currentUser.level, rating, text: text.trim(),
        createdAt: new Date().toISOString(), helpfulCount: 0, reports: 0
      };
      if (!this.reviews[labId]) this.reviews[labId] = [];
      this.reviews[labId].unshift(review);
      if (!this.ratings[labId]) this.ratings[labId] = [];
      this.ratings[labId].push({ userId: this.currentUser.id, rating });
      localStorage.setItem('gsvt_reviews', JSON.stringify(this.reviews));
      localStorage.setItem('gsvt_ratings', JSON.stringify(this.ratings));
      return { success: true, review };
    }
    deleteReview(labId, reviewId) {
      if (!this.currentUser) return false;
      const reviews = this.reviews[labId] || [];
      const index = reviews.findIndex(r => r.id === reviewId);
      if (index === -1 || reviews[index].userId !== this.currentUser.id) return false;
      reviews.splice(index, 1);
      this.reviews[labId] = reviews;
      localStorage.setItem('gsvt_reviews', JSON.stringify(this.reviews));
      return true;
    }
    markHelpful(reviewId) {
      if (!this.currentUser || this.helpful.includes(reviewId)) return false;
      this.helpful.push(reviewId);
      Object.keys(this.reviews).forEach(labId => {
        const review = this.reviews[labId].find(r => r.id === reviewId);
        if (review) review.helpfulCount++;
      });
      localStorage.setItem('gsvt_helpful', JSON.stringify(this.helpful));
      localStorage.setItem('gsvt_reviews', JSON.stringify(this.reviews));
      return true;
    }
    reportReview(reviewId) {
      if (this.reports && this.reports.includes(reviewId)) return false;
      if (!this.reports) this.reports = [];
      this.reports.push(reviewId);
      localStorage.setItem('gsvt_reports', JSON.stringify(this.reports));
      return true;
    }
    getLeaderboard() {
      const userStats = {};
      Object.keys(this.reviews).forEach(labId => {
        this.reviews[labId].forEach(review => {
          if (!userStats[review.userId]) {
            userStats[review.userId] = {
              userId: review.userId, userName: review.userName,
              userLevel: review.userLevel, reviewCount: 0,
              totalRating: 0, helpfulCount: 0
            };
          }
          userStats[review.userId].reviewCount++;
          userStats[review.userId].totalRating += review.rating;
          userStats[review.userId].helpfulCount += review.helpfulCount;
        });
      });
      return Object.values(userStats)
        .sort((a, b) => (b.reviewCount * 10 + b.helpfulCount) - (a.reviewCount * 10 + a.helpfulCount))
        .slice(0, 10);
    }
    getTimeAgo(dateString) {
      const date = new Date(dateString);
      const now = new Date();
      const diffMs = now - date;
      const diffMins = Math.floor(diffMs / 60000);
      const diffHours = Math.floor(diffMs / 3600000);
      const diffDays = Math.floor(diffMs / 86400000);
      const texts = reviewData[currentLang];
      if (diffMins < 1) return texts.justNow;
      if (diffMins < 60) return texts.minutesAgo.replace('{{minutes}}', diffMins);
      if (diffHours < 24) return texts.hoursAgo.replace('{{hours}}', diffHours);
      return texts.daysAgo.replace('{{days}}', diffDays);
    }
  }

  class ReviewUI {
    constructor(reviewSystem) {
      this.reviewSystem = reviewSystem;
      this.currentLabId = 'general';
      this.sortBy = 'newest';
    }
    renderReviewSection(labId, containerId) {
      this.currentLabId = labId;
      const container = document.getElementById(containerId);
      if (!container) return;
      const data = reviewData[currentLang];
      const reviews = this.reviewSystem.getLabReviews(labId);
      const avgRating = this.reviewSystem.getLabRating(labId);
      const ratingCount = this.reviewSystem.getLabRatingCount(labId);
      container.innerHTML = `
        <div class="review-section">
          <div class="review-header"><h3>${data.title}</h3><p>${data.subtitle}</p></div>
          <div class="review-stats">
            <div class="review-stat-card">
              <div class="review-stat-value">${avgRating}</div>
              <div class="review-stat-label">⭐ ${data.avgRating}</div>
              <div class="review-stat-sub">${ratingCount} ${data.reviews}</div>
            </div>
            <div class="review-stat-card">
              <div class="review-stat-value">${reviews.length}</div>
              <div class="review-stat-label">📝 ${data.totalReviews}</div>
            </div>
          </div>
          ${this.reviewSystem.currentUser ? this.renderReviewForm() : '<p class="review-login-prompt">سجل دخولك لمشاركة مراجعتك</p>'}
          <div class="review-sort">
            <label>${data.sortBy}:</label>
            <select id="review-sort-select">
              <option value="newest">${data.newest}</option>
              <option value="highest">${data.highest}</option>
              <option value="helpful">${data.mostHelpful}</option>
            </select>
          </div>
          <div class="review-list" id="review-list">
            ${reviews.length === 0 ? `<p class="no-reviews">${data.noReviews}</p>` : this.renderReviews(reviews)}
          </div>
          <div class="review-leaderboard">
            <h4>🏆 ${data.leaderboard}</h4>
            <p>${data.topReviewers}</p>
            ${this.renderLeaderboard()}
          </div>
        </div>
      `;
      this.setupEventListeners();
    }
    renderReviewForm() {
      const data = reviewData[currentLang];
      return `
        <div class="review-form">
          <h4>${data.yourRating}</h4>
          <div class="star-rating" id="star-rating">
            ${[1,2,3,4,5].map(i => `<span class="star" data-rating="${i}">★</span>`).join('')}
          </div>
          <input type="hidden" id="review-rating" value="0">
          <h4>${data.yourReview}</h4>
          <textarea id="review-text" placeholder="${data.writeReview}" rows="4"></textarea>
          <small class="review-hint">${data.minChars}</small>
          <button id="review-submit" class="review-submit-btn">${data.submit}</button>
          <div id="review-message" class="review-message"></div>
        </div>
      `;
    }
    renderReviews(reviews) {
      const data = reviewData[currentLang];
      const sorted = this.sortReviews(reviews);
      return sorted.map(review => {
        const isHelpful = this.reviewSystem.helpful.includes(review.id);
        const isOwner = this.reviewSystem.currentUser && this.reviewSystem.currentUser.id === review.userId;
        return `
          <div class="review-card" data-review-id="${review.id}">
            <div class="review-card-header">
              <div class="review-user-info">
                <div class="review-user-avatar">${review.userName.charAt(0).toUpperCase()}</div>
                <div><strong>${review.userName}</strong><span class="review-user-level">${review.userLevel}</span></div>
              </div>
              <div class="review-rating">${'★'.repeat(review.rating)}${'☆'.repeat(5 - review.rating)}</div>
            </div>
            <div class="review-text">${review.text}</div>
            <div class="review-card-footer">
              <span class="review-time">${this.reviewSystem.getTimeAgo(review.createdAt)}</span>
              <div class="review-actions">
                <button class="review-helpful-btn ${isHelpful ? 'is-helpful' : ''}" data-review-id="${review.id}">👍 ${data.helpful} (${review.helpfulCount})</button>
                <button class="review-report-btn" data-review-id="${review.id}">🚩 ${data.report}</button>
                ${isOwner ? `<button class="review-delete-btn" data-review-id="${review.id}">🗑️ حذف</button>` : ''}
              </div>
            </div>
          </div>
        `;
      }).join('');
    }
    renderLeaderboard() {
      const leaderboard = this.reviewSystem.getLeaderboard();
      const data = reviewData[currentLang];
      if (leaderboard.length === 0) return '<p>لا يوجد مراجعون بعد</p>';
      return `
        <div class="leaderboard-list">
          ${leaderboard.map((user, index) => `
            <div class="leaderboard-item">
              <div class="leaderboard-rank">${index + 1}</div>
              <div class="leaderboard-avatar">${user.userName.charAt(0).toUpperCase()}</div>
              <div class="leaderboard-info"><strong>${user.userName}</strong><span>${user.userLevel}</span></div>
              <div class="leaderboard-stats"><span>${user.reviewCount} ${data.reviews}</span><span>👍 ${user.helpfulCount}</span></div>
            </div>
          `).join('')}
        </div>
      `;
    }
    sortReviews(reviews) {
      const sorted = [...reviews];
      switch (this.sortBy) {
        case 'highest': return sorted.sort((a, b) => b.rating - a.rating);
        case 'helpful': return sorted.sort((a, b) => b.helpfulCount - a.helpfulCount);
        case 'newest':
        default: return sorted.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
      }
    }
    setupEventListeners() {
      document.querySelectorAll('.star').forEach(star => {
        star.addEventListener('click', () => {
          const rating = parseInt(star.dataset.rating);
          document.getElementById('review-rating').value = rating;
          document.querySelectorAll('.star').forEach((s, index) => {
            s.classList.toggle('is-selected', index < rating);
          });
        });
      });
      const submitBtn = document.getElementById('review-submit');
      if (submitBtn) {
        submitBtn.addEventListener('click', () => {
          const rating = parseInt(document.getElementById('review-rating').value);
          const text = document.getElementById('review-text').value.trim();
          const messageEl = document.getElementById('review-message');
          if (rating === 0) { messageEl.textContent = 'اختر تقييماً أولاً'; messageEl.className = 'review-message error'; return; }
          const result = this.reviewSystem.addReview(this.currentLabId, rating, text);
          if (result.success) {
            messageEl.textContent = reviewData[currentLang].success;
            messageEl.className = 'review-message success';
            setTimeout(() => { this.renderReviewSection(this.currentLabId, 'review-container'); }, 1500);
          } else { messageEl.textContent = result.message; messageEl.className = 'review-message error'; }
        });
      }
      const sortSelect = document.getElementById('review-sort-select');
      if (sortSelect) {
        sortSelect.addEventListener('change', (e) => {
          this.sortBy = e.target.value;
          const reviews = this.reviewSystem.getLabReviews(this.currentLabId);
          document.getElementById('review-list').innerHTML =
            reviews.length === 0 ? `<p class="no-reviews">${reviewData[currentLang].noReviews}</p>` : this.renderReviews(reviews);
          this.setupReviewActions();
        });
      }
      this.setupReviewActions();
    }
    setupReviewActions() {
      const data = reviewData[currentLang];
      document.querySelectorAll('.review-helpful-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const reviewId = btn.dataset.reviewId;
          if (this.reviewSystem.markHelpful(reviewId)) {
            btn.classList.add('is-helpful');
            const review = Object.values(this.reviewSystem.reviews).flat().find(r => r.id === reviewId);
            if (review) btn.textContent = `👍 ${data.helpful} (${review.helpfulCount})`;
          }
        });
      });
      document.querySelectorAll('.review-report-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const reviewId = btn.dataset.reviewId;
          if (this.reviewSystem.reportReview(reviewId)) alert(data.reportSubmitted);
        });
      });
      document.querySelectorAll('.review-delete-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const reviewId = btn.dataset.reviewId;
          if (confirm(data.confirmDelete)) {
            if (this.reviewSystem.deleteReview(this.currentLabId, reviewId)) {
              alert(data.deleted);
              this.renderReviewSection(this.currentLabId, 'review-container');
            }
          }
        });
      });
    }
  }

  const reviewSystem = new ReviewSystem();
  const reviewUI = new ReviewUI(reviewSystem);
  window.GoSVTReview = { reviewSystem, reviewUI };
})();
"""

