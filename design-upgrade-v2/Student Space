  const imageDatabase = {
    cell: { commonsQuery: 'plant cell diagram', alternatives: ['https://upload.wikimedia.org/wikipedia/commons/thumb/2/29/Plant_cell_structure_svg-en.svg/800px-Plant_cell_structure_svg-en.svg.png'] },
    genetics: { commonsQuery: 'DNA double helix', alternatives: ['https://upload.wikimedia.org/wikipedia/commons/thumb/e/e8/DNA_Structure%2BKey%2BLabel%2Bpno1%2BSeven%2BFrame_Small.png/800px-DNA_Structure%2BKey%2BLabel%2Bpno1%2BSeven%2BFrame_Small.png'] },
    ecology: { commonsQuery: 'ecosystem forest', alternatives: ['https://upload.wikimedia.org/wikipedia/commons/thumb/6/6d/Rainforest_Daintree_Australia.jpg/800px-Rainforest_Daintree_Australia.jpg'] },
    geology: { commonsQuery: 'igneous rock sample', alternatives: ['https://upload.wikimedia.org/wikipedia/commons/thumb/4/4e/Granite_granitic_rock.jpg/800px-Granite_granitic_rock.jpg'] },
    photosynthesis: { commonsQuery: 'photosynthesis leaf', alternatives: ['https://upload.wikimedia.org/wikipedia/commons/thumb/2/22/Photosynthesis_en.svg/800px-Photosynthesis_en.svg.png'] },
    anatomy: { commonsQuery: 'human digestive system', alternatives: ['https://upload.wikimedia.org/wikipedia/commons/thumb/6/6d/Digestive_system_diagram_en.svg/800px-Digestive_system_diagram_en.svg.png'] }
  };

  class RealImagesSystem {
    constructor() {
      this.imageCache = JSON.parse(localStorage.getItem('gsvt_image_cache') || '{}');
    }
    async fetchCommonsImage(query, width = 800) {
      const cacheKey = `${query}_${width}`;
      if (this.imageCache[cacheKey]) return this.imageCache[cacheKey];
      try {
        const params = new URLSearchParams({
          action: 'query', format: 'json', origin: '*',
          generator: 'search', gsrnamespace: '6',
          gsrsearch: `${query} filetype:bitmap`, gsrlimit: '3',
          prop: 'imageinfo', iiprop: 'url|extmetadata|size|mime',
          iiurlwidth: String(width)
        });
        const response = await fetch(`https://commons.wikimedia.org/w/api.php?${params.toString()}`, { headers: { 'Accept': 'application/json' } });
        if (!response.ok) throw new Error('Commons API error');
        const payload = await response.json();
        const candidates = payload?.query?.pages ? Object.values(payload.query.pages).map(page => ({ page, info: page?.imageinfo?.[0] })).filter(item => item.info?.thumburl && /^image\\/(jpeg|png|webp)$/i.test(item.info.mime || '') && Number(item.info.width) >= 320).sort((a, b) => (Number(b.info.width) * Number(b.info.height)) - (Number(a.info.width) * Number(a.info.height))) : [];
        if (candidates.length === 0) return null;
        const selected = candidates[0];
        const result = {
          url: selected.info.thumburl,
          sourceUrl: selected.info.descriptionurl,
          author: this.extractMetadata(selected.info.extmetadata?.Artist),
          license: this.extractMetadata(selected.info.extmetadata?.LicenseShortName),
          title: selected.page.title
        };
        this.imageCache[cacheKey] = result;
        localStorage.setItem('gsvt_image_cache', JSON.stringify(this.imageCache));
        return result;
      } catch (error) { console.warn('[RealImages] Commons fetch failed:', error); return null; }
    }
    extractMetadata(value) {
      if (!value) return 'Unknown';
      const str = String(value.value || value);
      return str.replace(/<[^>]+>/g, '').replace(/&nbsp;/gi, ' ').trim() || 'Unknown';
    }
    async getImage(category) {
      const config = imageDatabase[category];
      if (!config) return null;
      const commonsResult = await this.fetchCommonsImage(config.commonsQuery);
      if (commonsResult) return commonsResult;
      if (config.alternatives && config.alternatives.length > 0) {
        return { url: config.alternatives[0], sourceUrl: config.alternatives[0], author: 'Wikimedia Commons', license: 'CC License', title: category };
      }
      return null;
    }
    createImageCard(imageData, alt = '') {
      if (!imageData) return '<div class="ri-placeholder">صورة غير متاحة</div>';
      return `
        <div class="ri-image-card">
          <div class="ri-image-frame">
            <img src="${imageData.url}" alt="${alt}" loading="lazy" class="ri-image" onerror="this.parentElement.innerHTML='<div class=\\'ri-error\\'>تعذر تحميل الصورة</div>'">
            <div class="ri-image-overlay"><button class="ri-expand-btn" aria-label="تكبير">🔍</button></div>
          </div>
          <div class="ri-image-info">
            <a href="${imageData.sourceUrl}" target="_blank" rel="noopener" class="ri-source-link">📷 ${imageData.author}</a>
            <span class="ri-license">📜 ${imageData.license}</span>
          </div>
        </div>
      `;
    }
    async populateLabImages() {
      const containers = document.querySelectorAll('[data-real-images]');
      for (const container of containers) {
        const category = container.dataset.realImages;
        const imageData = await this.getImage(category);
        if (imageData) container.innerHTML = this.createImageCard(imageData, category);
      }
    }
  }

  const realImages = new RealImagesSystem();
  window.GoSVTImages = realImages;
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => realImages.populateLabImages());
  } else { realImages.populateLabImages(); }
})();
"""

