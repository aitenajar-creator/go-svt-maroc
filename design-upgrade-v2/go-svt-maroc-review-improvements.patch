+-- MAIN project only. Durable deletion markers prevent stale devices restoring deleted items.
+-- Prerequisite: the existing student_notes and student_study_plan baseline tables.
+create table if not exists public.student_collection_tombstones (
+  student_id uuid not null references auth.users(id) on delete cascade,
+  collection text not null check (collection in ('notes', 'studyPlan')),
+  item_key text not null check (char_length(item_key) between 1 and 500),
+  deleted_at timestamptz not null default now(),
+  primary key (student_id, collection, item_key)
+);
+alter table public.student_collection_tombstones enable row level security;
+revoke all on public.student_collection_tombstones from public, anon, authenticated;
+grant select on public.student_collection_tombstones to authenticated;
+create policy student_collection_tombstones_read_own
+  on public.student_collection_tombstones for select to authenticated
+  using (student_id = (select auth.uid()));
+
+-- All writes for an item share a transaction lock. Old clients' direct deletes
+-- also record a tombstone; stale inserts are skipped without losing other rows in a batch.
+create or replace function public.gosvt_guard_student_collection_item()
+returns trigger language plpgsql security definer
+set search_path = pg_catalog, public
+as $function$
+declare
+  v_collection text := case tg_table_name when 'student_notes' then 'notes' else 'studyPlan' end;
+  v_student uuid;
+  v_key text;
+begin
+  if tg_op = 'DELETE' then
+    v_student := old.student_id;
+    v_key := case tg_table_name when 'student_notes' then to_jsonb(old)->>'content_key' else to_jsonb(old)->>'item_key' end;
+  else
+    v_student := new.student_id;
+    v_key := case tg_table_name when 'student_notes' then to_jsonb(new)->>'content_key' else to_jsonb(new)->>'item_key' end;
+  end if;
+  -- Cascading account deletion must not recreate a row referencing the deleted user.
+  if tg_op = 'DELETE' and not exists (select 1 from auth.users where id = v_student) then return old; end if;
+  perform pg_advisory_xact_lock(hashtextextended(v_student::text || ':' || v_collection || ':' || v_key, 0));
+  if tg_op = 'DELETE' then
+    insert into public.student_collection_tombstones(student_id, collection, item_key)
+    values (v_student, v_collection, v_key) on conflict do nothing;
+    return old;
+  end if;
+  if exists (select 1 from public.student_collection_tombstones
+             where student_id = v_student and collection = v_collection and item_key = v_key) then
+    return null;
+  end if;
+  -- A stale device must not replace a newer note or planner entry.
+  if tg_op = 'UPDATE' and new.updated_at < old.updated_at then return null; end if;
+  return new;
+end;
+$function$;
+revoke all on function public.gosvt_guard_student_collection_item() from public, anon, authenticated;
+
+create trigger gosvt_notes_deletion_guard
+  before insert or update or delete on public.student_notes
+  for each row execute function public.gosvt_guard_student_collection_item();
+create trigger gosvt_study_plan_deletion_guard
+  before insert or update or delete on public.student_study_plan
+  for each row execute function public.gosvt_guard_student_collection_item();
+
+-- Mark even an item that has not reached the cloud yet. The owner comes from
+-- auth.uid(); the expected identity only guards requests delayed across account switches.
+create or replace function public.gosvt_delete_student_collection_item(p_collection text, p_item_key text, p_expected_student_id uuid)
+returns boolean language plpgsql security definer
+set search_path = pg_catalog, public
+as $function$
+declare v_student uuid := auth.uid();
+begin
+  if v_student is null then raise exception 'authentication_required' using errcode = '42501'; end if;
+  if p_expected_student_id is distinct from v_student then raise exception 'session_changed' using errcode = '42501'; end if;
+  if p_collection is null or p_collection not in ('notes', 'studyPlan')
+     or p_item_key is null or char_length(p_item_key) not between 1 and 500 then
+    raise exception 'invalid_collection_item' using errcode = '22023';
+  end if;
+  perform pg_advisory_xact_lock(hashtextextended(v_student::text || ':' || p_collection || ':' || p_item_key, 0));
+  insert into public.student_collection_tombstones(student_id, collection, item_key)
+  values (v_student, p_collection, p_item_key) on conflict do nothing;
+  if p_collection = 'notes' then
+    delete from public.student_notes where student_id = v_student and content_key = p_item_key;
+  else
+    delete from public.student_study_plan where student_id = v_student and item_key = p_item_key;
+  end if;
+  return true;
+end;
+$function$;
+revoke all on function public.gosvt_delete_student_collection_item(text, text, uuid) from public, anon;
+grant execute on function public.gosvt_delete_student_collection_item(text, text, uuid) to authenticated;
diff --git a/supabase/migrations/20261125000200_per_lesson_objectives.sql b/supabase/migrations/20261125000200_per_lesson_objectives.sql
new file mode 100644
index 0000000000000000000000000000000000000000..f2b9d9c71993e1d06e96ee3cb69bff979934be67
--- /dev/null
+++ b/supabase/migrations/20261125000200_per_lesson_objectives.sql
@@ -0,0 +1,32 @@
+-- MAIN project only. One row per student/lesson avoids replacing unrelated lesson progress.
+-- The previous JSON column remains intact for rollback and older clients.
+create table if not exists public.student_lesson_objectives (
+  student_id uuid not null references auth.users(id) on delete cascade,
+  lesson_id uuid not null references public.private_student_lessons(id) on delete cascade,
+  checked_indices integer[] not null default '{}',
+  updated_at timestamptz not null default now(),
+  primary key (student_id, lesson_id),
+  constraint student_lesson_objectives_valid_indices check (
+    cardinality(checked_indices) <= 200 and array_position(checked_indices, null) is null
+    and 0 <= all(checked_indices) and 199 >= all(checked_indices)
+  )
+);
+create index student_lesson_objectives_lesson_idx on public.student_lesson_objectives(lesson_id);
+alter table public.student_lesson_objectives enable row level security;
+revoke all on public.student_lesson_objectives from public, anon, authenticated;
+grant select, insert, update on public.student_lesson_objectives to authenticated;
+create policy student_lesson_objectives_owner_all
+  on public.student_lesson_objectives for all to authenticated
+  using (student_id = (select auth.uid()))
+  with check (student_id = (select auth.uid()));
+
+insert into public.student_lesson_objectives(student_id, lesson_id, checked_indices)
+select state.student_id, lesson.id,
+       array(select distinct index_value from (
+         select case when value ~ '^[0-9]{1,3}$' then value::integer end as index_value
+         from jsonb_array_elements_text(case when jsonb_typeof(entry.value) = 'array' then entry.value else '[]'::jsonb end)
+       ) valid where index_value between 0 and 199 order by index_value)
+from public.student_learning_state state
+cross join lateral jsonb_each(state.lesson_objectives) entry
+join public.private_student_lessons lesson on entry.key = 'private-lesson:' || lesson.id::text
+on conflict (student_id, lesson_id) do nothing;
diff --git a/supabase/migrations/20261125000300_atomic_teacher_question_replies.sql b/supabase/migrations/20261125000300_atomic_teacher_question_replies.sql
new file mode 100644
index 0000000000000000000000000000000000000000..54718c220d34695b2d26deabf23bf0da728839b3
--- /dev/null
+++ b/supabase/migrations/20261125000300_atomic_teacher_question_replies.sql
@@ -0,0 +1,56 @@
+-- MAIN project only. Save a reply and its question status in a single transaction.
+alter table public.teacher_question_messages add column if not exists client_message_id text;
+alter table public.teacher_question_messages add constraint teacher_message_client_id_length
+  check (client_message_id is null or char_length(client_message_id) between 1 and 200);
+create unique index teacher_message_client_id_unique
+  on public.teacher_question_messages(sender_id, client_message_id)
+  where client_message_id is not null;
+
+create or replace function public.gosvt_send_teacher_reply(
+  p_question_id uuid, p_body text, p_client_message_id text, p_expected_sender_id uuid
+)
+returns uuid language plpgsql security definer
+set search_path = pg_catalog, public
+as $function$
+declare
+  v_user uuid := auth.uid();
+  v_question public.teacher_questions%rowtype;
+  v_existing public.teacher_question_messages%rowtype;
+  v_role text;
+  v_message_id uuid;
+begin
+  if v_user is null then raise exception 'authentication_required' using errcode = '42501'; end if;
+  if p_expected_sender_id is distinct from v_user then raise exception 'session_changed' using errcode = '42501'; end if;
+  if p_body is null or char_length(trim(p_body)) not between 1 and 8000
+     or p_client_message_id is null or char_length(p_client_message_id) not between 1 and 200 then
+    raise exception 'invalid_reply' using errcode = '22023';
+  end if;
+  select role::text into v_role from public.profiles where id = v_user;
+  select * into v_question from public.teacher_questions where id = p_question_id for update;
+  if not found or not coalesce(
+    (v_role = 'student' and v_question.student_id = v_user)
+    or (v_role in ('teacher', 'admin') and public.gosvt_can_manage_class(v_question.class_id)), false
+  ) then raise exception 'not_authorized' using errcode = '42501'; end if;
+
+  insert into public.teacher_question_messages(question_id, sender_id, body, client_message_id)
+  values (p_question_id, v_user, trim(p_body), p_client_message_id)
+  on conflict (sender_id, client_message_id) where client_message_id is not null do nothing
+  returning id into v_message_id;
+  if v_message_id is null then
+    select * into v_existing from public.teacher_question_messages
+      where sender_id = v_user and client_message_id = p_client_message_id;
+    if v_existing.question_id is distinct from p_question_id or v_existing.body is distinct from trim(p_body) then
+      raise exception 'reply_token_already_used' using errcode = '22023';
+    end if;
+    -- A retried old message must not overwrite the status of a newer reply.
+    return v_existing.id;
+  end if;
+  update public.teacher_questions
+    set status = case when v_role = 'student' then 'new' else 'answered' end,
+        updated_at = now()
+    where id = p_question_id;
+  return v_message_id;
+end;
+$function$;
+revoke all on function public.gosvt_send_teacher_reply(uuid, text, text, uuid) from public, anon;
+grant execute on function public.gosvt_send_teacher_reply(uuid, text, text, uuid) to authenticated;
