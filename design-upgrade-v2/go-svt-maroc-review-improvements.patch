+  const uploads=[];
+  c.StudentAccount={isLoggedIn:()=>true,isReady:()=>true,activeProfileId:()=>id,getUser:()=>({id:'fixture-user'}),getProfile:()=>({role:'student'})};
+  c.GoSVTCloud={syncNotes:async rows=>uploads.push(rows)};
